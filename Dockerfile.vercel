FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY KudosWall.Api/KudosWall.Api.csproj KudosWall.Api/
COPY KudosWall.Api/ KudosWall.Api/
RUN dotnet publish KudosWall.Api/KudosWall.Api.csproj -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled
WORKDIR /app
COPY --from=build /app .
COPY kudos-wall.html ./wwwroot/index.html
ENV PORT=80 DOTNET_EnableDiagnostics=0
ENTRYPOINT ["dotnet", "KudosWall.Api.dll"]
